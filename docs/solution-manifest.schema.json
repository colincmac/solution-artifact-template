{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/colincmac/solution-artifact-template/docs/solution-manifest.schema.json",
  "title": "Solution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateVersion", "repository", "solution", "entryPoints", "synthesisExclusions", "publicationReview"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "templateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "visibility", "defaultRef"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["public", "private"] },
        "defaultRef": { "type": "string", "minLength": 1 }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "maturity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["concept", "prototype", "showcase", "pilot", "production", "maintenance", "deprecated"] }
      }
    },
    "entryPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "architectureIndex", "adrIndex", "deployment", "runbooks", "observability", "evidence", "publicationBrief"],
      "properties": {
        "overview": { "type": "string", "minLength": 1 },
        "architectureIndex": { "type": "string", "minLength": 1 },
        "adrIndex": { "type": "string", "minLength": 1 },
        "deployment": { "type": "string", "minLength": 1 },
        "runbooks": { "type": "string", "minLength": 1 },
        "observability": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "publicationBrief": { "type": "string", "minLength": 1 },
        "implementation": { "type": ["string", "null"] },
        "automation": { "type": ["string", "null"] }
      }
    },
    "synthesisExclusions": {
      "type": "array",
      "description": "Editorial guidance only, not access controls.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "oneOf": [{ "required": ["path"] }, { "required": ["glob"] }],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "glob": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publicationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanReview", "notes"],
      "properties": {
        "requiresHumanReview": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "extensions": { "type": "object", "description": "Repository-specific metadata outside the canonical contract." }
  }
}
