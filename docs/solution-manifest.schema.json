{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/colincmac/solution-artifact-template/docs/solution-manifest.schema.json",
  "title": "Solution Manifest",
  "description": "Entry-point contract for a solution repository created from the solution-artifact-template.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "solution",
    "entryPoints"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Version of this schema the document conforms to.",
      "enum": ["1.0.0"]
    },
    "templateVersion": {
      "type": "string",
      "description": "Version of the template this repository was created from.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "solution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "maturity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Short, stable, kebab-case identifier for this solution."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "maturity": {
          "type": "string",
          "enum": ["prototype", "pilot", "production", "deprecated"]
        }
      }
    },
    "entryPoints": {
      "type": "object",
      "description": "Repository-relative entry points. Required keys must be non-null local paths; optional keys may be null.",
      "additionalProperties": {
        "type": ["string", "null"]
      },
      "required": [
        "overview",
        "architectureIndex",
        "adrIndex",
        "deployment",
        "runbooks",
        "observability",
        "evidence",
        "publicationBrief"
      ],
      "properties": {
        "overview": { "type": "string", "minLength": 1 },
        "architectureIndex": { "type": "string", "minLength": 1 },
        "adrIndex": { "type": "string", "minLength": 1 },
        "deployment": { "type": "string", "minLength": 1 },
        "runbooks": { "type": "string", "minLength": 1 },
        "observability": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "publicationBrief": { "type": "string", "minLength": 1 },
        "implementation": { "type": ["string", "null"] },
        "automation": { "type": ["string", "null"] }
      }
    },
    "synthesisExclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "publicationReview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requiresHumanReview": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
